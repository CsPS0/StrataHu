# StrataHu Discord Bot & Agent Bridge konfiguráció

# 1. A bot tokenje (Discord Developer Portal -> Bot -> Reset Token)
DISCORD_BOT_TOKEN=

# 2. A Discord szerver (Guild) azonosítója (Jobb klikk a szerver ikonjára -> Copy Server ID)
DISCORD_GUILD_ID=

# 3. A bot alkalmazás azonosítója (Discord Developer Portal -> General Information -> Application ID)
DISCORD_CLIENT_ID=
